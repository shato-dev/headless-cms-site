# Copy this file to .env and fill in real values (.env is gitignored — never commit it).
# Used by scripts/import-to-microcms.mjs (Phase B of M2, after the microCMS
# service exists). See PLAN.md's M2 section for the account setup steps.

MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# Used by docker-compose.yml (M4: local PostgreSQL + Meilisearch).
# POSTGRES_USER / POSTGRES_DB: any simple names (e.g. app). POSTGRES_PASSWORD / MEILI_MASTER_KEY: random strings.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MEILI_MASTER_KEY=

# Used by scripts/seed-events.mjs (M5). Optional: when empty, the script builds the
# connection from POSTGRES_* above against 127.0.0.1:5432. Set it (postgres://...)
# only to point at another database; non-local hosts also need --allow-remote.
DATABASE_URL=

# The events-api Bearer token (M5 Phase 3). Only for calling the deployed API from
# your own machine (e.g. curl); the Worker itself gets it via `wrangler secret put
# API_TOKEN`. Local `wrangler dev` uses workers/events-api/.dev.vars instead.
EVENTS_API_TOKEN=
