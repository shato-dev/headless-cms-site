---
// Search box shown in the site header on every page.
// Nothing happens in this frontmatter at runtime — all the work is in the
// <script> below, which is bundled into dist/ and runs in the visitor's
// browser each time they type. (Same two-region split as astro-warmup;
// see ../../astro-warmup/KNOWLEDGE.md.)
---

<div class="search">
  <label class="visually-hidden" for="search-input">作品を検索</label>
  <input
    type="search"
    id="search-input"
    placeholder="タイトル・著者・要約を検索…"
    autocomplete="off"
  />
  <div class="search-dropdown">
    <p id="search-fallback-note" class="search-fallback-note" hidden>
      検索サーバーが起動中のため、簡易検索の結果を表示しています
    </p>
    <ul id="search-results" class="search-results" hidden></ul>
  </div>
</div>

<script>
  // M6: search is served by a Cloudflare Worker in front of Meilisearch
  // (workers/search-api/), which itself talks to Meilisearch running on
  // Render's free plan. Render Free spins down after 15 idle minutes and
  // takes about a minute to wake back up, so this component always has a
  // fallback: the same build-time search.json + filter() this site used
  // before M6 (src/pages/search.json.js). Neither URL below is a secret —
  // both are public API endpoints.
  const SEARCH_API_URL = 'https://search-api.shato-dev.workers.dev';
  const DEBOUNCE_MS = 200;

  type Result = { title: string; author: string; url: string };
  type FallbackEntry = { title: string; author: string; summary: string; url: string };

  const input = document.querySelector<HTMLInputElement>('#search-input')!;
  const results = document.querySelector<HTMLUListElement>('#search-results')!;
  const fallbackNote = document.querySelector<HTMLParagraphElement>('#search-fallback-note')!;

  let fallbackEntries: FallbackEntry[] | null = null;
  let debounceTimer: ReturnType<typeof setTimeout> | undefined;
  let currentRequest: AbortController | null = null;
  let warmedUp = false;

  // Wake a sleeping Render instance as soon as the visitor shows search
  // intent, so it has a head start before their first query arrives. Only
  // once per page load; failures are ignored (the search itself still falls
  // back if the instance isn't ready yet).
  function warmUp() {
    if (warmedUp) return;
    warmedUp = true;
    fetch(`${SEARCH_API_URL}/warmup`).catch(() => {});
  }

  // The pre-M6 client-side search: fetch search.json once, then filter() in
  // the browser. Used whenever the API is unavailable or too slow.
  async function loadFallbackIndex(): Promise<FallbackEntry[]> {
    if (fallbackEntries) return fallbackEntries;
    const res = await fetch('/search.json');
    fallbackEntries = await res.json();
    return fallbackEntries!;
  }

  async function searchFallback(query: string): Promise<Result[]> {
    const entries = await loadFallbackIndex();
    const q = query.toLowerCase();
    return entries
      .filter(
        (entry) =>
          entry.title.toLowerCase().includes(q) ||
          entry.author.toLowerCase().includes(q) ||
          entry.summary.toLowerCase().includes(q),
      )
      .slice(0, 20)
      .map(({ title, author, url }) => ({ title, author, url }));
  }

  // Try the search API first; fall back to client-side filtering for this
  // query if it errors, times out, or the Worker itself reports the upstream
  // as unavailable (503). Returns null if `signal` was aborted by a newer
  // keystroke — the caller should discard the (now stale) result.
  async function search(
    query: string,
    signal: AbortSignal,
  ): Promise<{ results: Result[]; fallback: boolean } | null> {
    try {
      const res = await fetch(`${SEARCH_API_URL}/search?q=${encodeURIComponent(query)}&limit=20`, { signal });
      if (!res.ok) throw new Error(`search API returned ${res.status}`);
      const data = (await res.json()) as { results: Result[] };
      return { results: data.results, fallback: false };
    } catch (err) {
      if (signal.aborted) return null;
      return { results: await searchFallback(query), fallback: true };
    }
  }

  function render(matches: Result[], hasQuery: boolean, fallback: boolean) {
    if (!hasQuery) {
      results.hidden = true;
      results.replaceChildren();
      fallbackNote.hidden = true;
      return;
    }

    results.hidden = false;
    fallbackNote.hidden = !fallback;

    if (matches.length === 0) {
      const li = document.createElement('li');
      li.className = 'search-empty';
      li.textContent = '一致する作品がありません';
      results.replaceChildren(li);
      return;
    }

    // Build nodes with the DOM API and set text via textContent. Never
    // splice data into an innerHTML string — that is how XSS bugs start.
    results.replaceChildren(
      ...matches.map((entry) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = entry.url;
        a.textContent = `${entry.title}(${entry.author})`;
        li.append(a);
        return li;
      }),
    );
  }

  input.addEventListener('focus', warmUp, { once: true });

  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    currentRequest?.abort();

    const query = input.value.trim();
    if (!query) {
      render([], false, false);
      return;
    }

    debounceTimer = setTimeout(async () => {
      const controller = new AbortController();
      currentRequest = controller;
      const outcome = await search(query, controller.signal);
      if (outcome === null) return; // superseded by a newer keystroke
      render(outcome.results, true, outcome.fallback);
    }, DEBOUNCE_MS);
  });
</script>

<style>
  .search {
    position: relative;
    margin-left: auto;
  }
  #search-input {
    padding: 0.3rem 0.6rem;
    font-size: 0.9rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--fg);
    width: 14rem;
    max-width: 40vw;
  }
  .search-dropdown {
    position: absolute;
    right: 0;
    z-index: 10;
    margin-top: 0.3rem;
    min-width: 18rem;
    max-width: 24rem;
  }
  .search-fallback-note {
    margin: 0 0 0.3rem;
    padding: 0.3rem 0.6rem;
    font-size: 0.8rem;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .search-results {
    margin: 0;
    padding: 0.3rem 0;
    list-style: none;
    max-height: 20rem;
    overflow-y: auto;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.12);
  }
  .search-results li {
    padding: 0.35rem 0.8rem;
    font-size: 0.9rem;
  }
  .search-results li a {
    text-decoration: none;
  }
  .search-empty {
    color: var(--muted);
  }
</style>
