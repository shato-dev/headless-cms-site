---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getWorks } from '../../lib/works';

// getStaticPaths: because this is a static site, we must list every URL
// this [id] file should produce at build time. One entry per work, keyed
// by the id we assigned in src/content/works.json (the Aozora Bunko work
// number extracted from its card URL).
export async function getStaticPaths() {
  // Declared inside the function: Astro extracts getStaticPaths into its
  // own isolated module at build time, so it cannot see top-level consts
  // defined elsewhere in this frontmatter.
  const MAX_RELATED = 4;
  const works = await getWorks();
  return works.map((work) => {
    // "Related works" is a plain build-time filter over the same list —
    // no extra data or API needed. The two lists may overlap (e.g. another
    // work by the same author in the same genre); that's fine for a
    // "you might also like" section.
    const sameAuthor = works
      .filter((other) => other.id !== work.id && other.data.author === work.data.author)
      .slice(0, MAX_RELATED);
    const sameGenre = works
      .filter(
        (other) =>
          other.id !== work.id && other.data.genreTags.some((tag) => work.data.genreTags.includes(tag)),
      )
      .slice(0, MAX_RELATED);

    return {
      params: { id: work.id },
      props: { work, sameAuthor, sameGenre },
    };
  });
}

const { work, sameAuthor, sameGenre } = Astro.props;
const { title, author, authorReading, translator, summary, genreTags, aozoraCardUrl } = work.data;
---

<BaseLayout title={title} description={summary}>
  <article>
    <h1>{title}</h1>
    <p class="work-author">
      著者: <a href={`/authors/${encodeURIComponent(author)}`}>{author}</a>
      {authorReading && <span class="work-reading">({authorReading})</span>}
      {translator && <span> / 訳: {translator}</span>}
    </p>
    <p class="work-tags">
      {genreTags.map((tag) => <a class="tag" href={`/genres/${encodeURIComponent(tag)}`}>{tag}</a>)}
    </p>

    <div class="work-summary">
      <p>{summary}</p>
    </div>

    <p class="work-source">
      出典: <a href={aozoraCardUrl} target="_blank" rel="noopener">青空文庫で読む</a>
    </p>

    <p><a href="/">← 作品一覧へ</a></p>
  </article>

  {sameAuthor.length > 0 && (
    <section class="related-works">
      <h2>{author}の他の作品</h2>
      {sameAuthor.map((related) => (
        <WorkCard
          id={related.id}
          title={related.data.title}
          author={related.data.author}
          summary={related.data.summary}
          genreTags={related.data.genreTags}
        />
      ))}
    </section>
  )}

  {sameGenre.length > 0 && (
    <section class="related-works">
      <h2>同じジャンルの作品</h2>
      {sameGenre.map((related) => (
        <WorkCard
          id={related.id}
          title={related.data.title}
          author={related.data.author}
          summary={related.data.summary}
          genreTags={related.data.genreTags}
        />
      ))}
    </section>
  )}
</BaseLayout>

<style>
  .work-author {
    margin: 0.3rem 0;
  }
  .work-reading {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .work-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin: 0.5rem 0 1.5rem;
  }
  .work-summary {
    font-size: 1.05rem;
  }
  .work-source {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .related-works {
    margin-top: 2rem;
  }
  .related-works h2 {
    font-size: 1.1rem;
  }
</style>
